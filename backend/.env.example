# ReplyMuse Environment Configuration

# Application
APP_NAME=ReplyMuse
ENVIRONMENT=development
DEBUG=True
API_V1_STR=/api
PORT=8000
HOST=0.0.0.0

# Security & Authentication
# Generate with: openssl rand -hex 32
SECRET_KEY=replaceme_super_secret_jwt_key_minimum_32_characters_long_for_security
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
COOKIE_SECURE=False
COOKIE_SAMESITE=lax

# Database (PostgreSQL / Neon in production, or SQLite for zero-setup local dev)
# For SQLite (default local dev): sqlite+aiosqlite:///./replymuse.db
# For PostgreSQL / Neon: postgresql+asyncpg://user:pass@ep-hostname.neon.tech/neondb?sslmode=require
DATABASE_URL=sqlite+aiosqlite:///./replymuse.db
SYNC_DATABASE_URL=sqlite:///./replymuse.db

# AI Provider Configuration
# Supported providers: "gemini" or "mock" (for testing/development without API key)
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Quotas & Limits
MONTHLY_FREE_GENERATION_LIMIT=10

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]
